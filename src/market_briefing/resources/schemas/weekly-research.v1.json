{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "published_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "percent",
              "basis_points",
              "percentage_points",
              "count",
              "usd",
              "ratio",
              "index_level",
              "text"
            ]
          },
          "reference_period": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "realized",
              "estimate"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "known_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "instrument": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "contract": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "adjustment": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "endpoint_status": {
            "type": "string",
            "enum": [
              "complete",
              "lagged"
            ]
          }
        },
        "required": [
          "id",
          "metric",
          "value",
          "unit",
          "reference_period",
          "classification",
          "source_id",
          "observed_at",
          "known_at",
          "verification",
          "instrument",
          "contract",
          "adjustment",
          "endpoint_status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic_key": {
            "type": "string",
            "minLength": 1
          },
          "event_at": {
            "type": "string",
            "format": "date-time"
          },
          "known_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "development": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "topic_key",
          "event_at",
          "known_at",
          "evidence_ids",
          "development"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scheduled_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "event_at": {
            "type": "string",
            "format": "date-time"
          },
          "known_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "tentative"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "event_at",
          "known_at",
          "source_id",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "comparison_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_id": {
            "type": "string",
            "minLength": 1
          },
          "end_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": [
              "return",
              "yield_change"
            ]
          }
        },
        "required": [
          "start_id",
          "end_id",
          "method"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "analysis": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "market.weekly-analysis.v1",
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "inference"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "temporal_type": {
                "type": "string",
                "enum": [
                  "realized",
                  "estimate",
                  "mixed",
                  "scheduled"
                ]
              }
            },
            "required": [
              "id",
              "text",
              "kind",
              "evidence_ids",
              "temporal_type"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "thesis": {
          "type": "object",
          "properties": {
            "stance": {
              "type": "string",
              "enum": [
                "constructive",
                "neutral",
                "cautious",
                "unassessable"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "horizon": {
              "const": "1-4w",
              "type": "string"
            },
            "drivers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "counterevidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "invalidation_conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "stance",
            "confidence",
            "horizon",
            "drivers",
            "counterevidence",
            "invalidation_conditions"
          ],
          "additionalProperties": false
        },
        "previous_view": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "absent",
                "available"
              ]
            },
            "week_start": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "comparison": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "week_start",
            "sha256",
            "comparison"
          ],
          "additionalProperties": false
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "enum": [
                  "core",
                  "macro",
                  "events",
                  "market_response",
                  "next_week"
                ]
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "commentary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "topic",
              "claim_ids",
              "commentary"
            ],
            "additionalProperties": false
          },
          "minItems": 5,
          "maxItems": 5
        },
        "selected_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "watchlist_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "comparison_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "claims",
        "thesis",
        "previous_view",
        "sections",
        "selected_event_ids",
        "watchlist_ids",
        "comparison_ids",
        "missing_inputs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sources",
    "observations",
    "events",
    "scheduled_events",
    "missing_inputs",
    "comparison_requests",
    "analysis"
  ],
  "additionalProperties": false
}
