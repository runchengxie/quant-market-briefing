{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "market.weekly-source-review.v1",
      "type": "string"
    },
    "product": {
      "const": "weekly",
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "hashes": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analysis": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "briefing": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "evidence",
        "analysis",
        "briefing"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "deferred",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim_id",
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "product",
    "week_start",
    "run_id",
    "revision",
    "reviewer",
    "reviewed_at",
    "hashes",
    "decisions"
  ],
  "additionalProperties": false
}
