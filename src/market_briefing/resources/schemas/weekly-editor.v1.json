{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "core",
              "macro",
              "events",
              "market_response",
              "next_week"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "topic",
          "heading",
          "text",
          "claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    }
  },
  "required": [
    "headline",
    "sections"
  ],
  "additionalProperties": false
}
