{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Existing intel web research v1.0 as unreviewed context",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "market_date": {
      "type": "string",
      "format": "date"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "review_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "supporting_passage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "review_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "phase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "source_timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "time_role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "usage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "source_url": {
            "type": "string",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
            "format": "uri",
            "maxLength": 4096
          },
          "observation_date": {
            "type": "string",
            "format": "date"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "publication_precision": {
            "enum": [
              "timestamp",
              "date"
            ]
          },
          "source_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "section",
          "title",
          "source_url",
          "summary",
          "supporting_passage",
          "observation_date",
          "review_status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "market_date",
    "cutoff",
    "generated_at",
    "accepted_count",
    "review_status",
    "candidates"
  ],
  "additionalProperties": true
}
