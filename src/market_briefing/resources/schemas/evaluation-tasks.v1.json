{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "market.evaluation-tasks.v1"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "kind": {
            "enum": [
              "repeat",
              "counterfactual",
              "paired",
              "failure"
            ]
          },
          "run_dir": {
            "type": "string",
            "minLength": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "enum": [
                    "bound",
                    "legacy",
                    "research"
                  ]
                }
              },
              "required": [
                "label",
                "path"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "observation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "enum": [
                    "value",
                    "unit",
                    "reference_period"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "observation_id",
                "field",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "repeats": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "comparison": {
            "enum": [
              "standard-deep",
              "bound-legacy"
            ]
          },
          "expected_error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "run_dir"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "tasks"
  ],
  "additionalProperties": false
}
