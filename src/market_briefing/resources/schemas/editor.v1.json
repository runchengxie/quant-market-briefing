{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    }
  },
  "required": [
    "headline",
    "paragraphs"
  ],
  "additionalProperties": false
}
